#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: ${k3s_config_path}
    permissions: "0600"
    encoding: b64
    content: ${k3s_config}
  - path: ${k3s_manifests_dir}/argocd.yaml
    permissions: "0600"
    encoding: b64
    content: ${argocd_manifest}
  - path: ${k3s_manifests_dir}/root-app.yaml
    permissions: "0600"
    encoding: b64
    content: ${root_app_manifest}

runcmd:
  - |
    (
      set -eu
      curl -sfL --retry 10 --retry-all-errors --retry-delay 5 -o /root/k3s-install.sh '${k3s_install_script}'
      echo '${k3s_install_script_sha256}  /root/k3s-install.sh' | sha256sum -c -
      INSTALL_K3S_VERSION='${k3s_version}' sh /root/k3s-install.sh
    )
